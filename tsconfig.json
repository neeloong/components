{
  "compilerOptions": {
    "checkJs": true,
    "module": "NodeNext",
    "target": "esnext",
    "allowJs": true,
    "sourceMap": true,
    "skipLibCheck": true,
    "moduleResolution": "NodeNext",
    "baseUrl": "./src",
    "strictNullChecks": true,
    "strict": true,
    "declaration": true,
    "outDir": "types",
    "emitDeclarationOnly": true
  },
  "include": ["./src"]
}
